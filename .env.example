# ===== Supabase (mode produksi) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Midtrans =====
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# sandbox | production
MIDTRANS_MODE=sandbox
# WAJIB sama dengan route webhook: app/api/payment/webhook
MIDTRANS_CALLBACK_URL=http://localhost:3000/api/payment/webhook

# ===== Resend (email) =====
RESEND_API_KEY=
# Opsional: alamat pengirim email terverifikasi (default: PesanManis <onboarding@resend.dev>)
RESEND_FROM_EMAIL=
# Email admin penerima notifikasi transaksi & akses /admin
ADMIN_EMAIL=

# ===== Kontak / Support =====
# Opsional: nomor WhatsApp admin format internasional tanpa + (contoh: 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ===== Upstash Redis (rate limit) =====
# Opsional di lokal; wajib di produksi agar rate limit berlaku lintas instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Cron =====
# Dipakai /api/cron/abandoned-cart (Vercel mengirim "Bearer <CRON_SECRET>")
CRON_SECRET=

# ===== App =====
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Cloudflare R2 (upload video lokal maks 50 MB) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
